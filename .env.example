# Indy settings. Copy this file to .env; compose reads it on every start.
# Only INDY_URL has to be set. Everything else has a working default.

# The address people open Indy at, with no trailing slash. Share links, agent
# setup snippets and cookies are all built from it, so it must match what is
# typed into the browser. Use https:// for anything reachable from the internet.
INDY_URL=http://localhost:1936

# The host port Indy listens on.
INDY_PORT=1936

# Which host address the port is published on. Set 127.0.0.1 when a proxy such
# as the bundled Caddy sits in front, so plain HTTP stays private.
# INDY_BIND=127.0.0.1

# How many reverse proxies sit in front of Indy (Traefik, nginx, the bundled
# Caddy). Set 1 behind one, so sign-in limits count each visitor separately.
# INDY_PROXY_HOPS=1

# HTTPS with the bundled Caddy (docker compose --profile https up -d).
# The domain's DNS must point at this server, and ports 80 and 443 must be open.
# INDY_DOMAIN=indy.example.com

# Email, through Resend (https://resend.com). Optional. It turns on sign-in
# codes, share links that ask for an email address, and nothing else.
# RESEND_API_KEY=re_...
# Any setting can come from a file instead, as Docker secrets are mounted:
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# The sender. Resend's test address only delivers to your own Resend account's
# email; use an address on a domain you verified with Resend to reach others.
# INDY_EMAIL_FROM=Indy <indy@example.com>

# "local" skips sign-in entirely: every request is treated as the owner.
# Only for an install nobody else can reach, such as one bound to 127.0.0.1.
# INDY_AUTH=local

# Folders an artifact may load images from by absolute path, separated by
# colons. Each must also be mounted into the container. Empty by default.
# INDY_ASSET_ROOTS=/srv/screenshots

# The image to run. Pin a release (…:1.2) to update on your own schedule, or
# point at your own build (docker build -t indy:local .).
# INDY_IMAGE=ghcr.io/liamdmcgarrigle/indy-artifacts:latest
