# Port on the host. Must stay inside the tailnet-allowed range 5170-5199.
ARTIFACTS_PORT=5174

# The address the operator reaches this at. Every URL handed to an agent is
# built from it, so set it before publishing anything.
ARTIFACTS_PUBLIC_URL=http://agentbox:5174

# Colon-separated roots an artifact may reference assets from, by absolute path.
ARTIFACTS_ASSET_ROOTS=/home/liam/work:/home/liam/orca:/tmp
